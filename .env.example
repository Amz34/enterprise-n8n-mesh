# ==============================================================================
# Enterprise n8n Mesh Configuration
# ==============================================================================

# General
N8N_HOST=n8n.yourdomain.com
WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_key_64_chars

# Database (PostgreSQL 16)
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n_enterprise
DB_POSTGRESDB_USER=agent_admin
DB_POSTGRESDB_PASSWORD=replace_with_postgres_password

# Distributed Queue (Redis 7)
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=replace_with_redis_password

# Observability & Alerting
N8N_DEFAULT_ERROR_WORKFLOW_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Apify Integration
APIFY_TOKEN=
