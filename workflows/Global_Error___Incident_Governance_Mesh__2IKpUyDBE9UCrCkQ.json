      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst exec = item.execution || {};\nconst wf = item.workflow || {};\nconst err = exec.error || {};\n\nconst execId = exec.id || 'N/A';\nconst wfName = wf.name || 'Unknown Workflow';\nconst wfId = wf.id || 'N/A';\nconst lastNode = exec.lastNodeExecuted || err.node || 'Unknown Node';\nconst errMsg = String(err.message || 'Execution halted unexpectedly').slice(0, 300);\nconst nowIso = new Date().toISOString();\nconst execUrl = `http://100.110.242.47:5678/execution/${execId}`;\n\nconst tgText = `🚨 <b>n8n Enterprise Workflow Incident</b>\n` +\n  `🕒 <code>${nowIso}</code>\n\n` +\n  `• <b>Workflow:</b> <code>${wfName}</code>\n` +\n  `• <b>Failed Node:</b> <code>${lastNode}</code>\n` +\n  `• <b>Error:</b> <code>${errMsg}</code>\n` +\n  `• <b>Execution:</b> <a href=\"${execUrl}\">#${execId} (Review Run)</a>`;\n\nreturn [{\n  json: {\n    execId,\n    wfName,\n    wfId,\n    lastNode,\n    errMsg,\n    timestamp: nowIso,\n    execUrl,\n    telegram_message: tgText,\n    chat_id: '8843884232'\n  }\n}];"
      },
      "id": "fmt-err-02",
