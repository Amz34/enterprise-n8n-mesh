{
  "name": "AZ Sentinel — Global Error Trigger -> @AzGem_Bot",
  "nodes": [
    {
      "parameters": {},
      "id": "err-trigger",
      "name": "On Any Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.AZGEM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $env.AZGEM_CHAT_ID }}" },
            {
              "name": "text",
              "value": "=🚨 n8n Workflow Error\\n• Workflow: {{ $json.workflow.name }}\\n• Node: {{ $json.execution.lastNodeExecuted }}\\n• Error: {{ $json.execution.error.message }}"
            }
          ]
        }
      },
      "id": "send-err-tg",
      "name": "Alert @AzGem_Bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    }
  ],
  "connections": {
    "On Any Workflow Error": { "main": [[{ "node": "Alert @AzGem_Bot", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
