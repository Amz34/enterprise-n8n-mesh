        180,
        240
      ],
      "webhookId": "wh-mit-lead-prod-01"
    },
    {
      "parameters": {
        "jsCode": "// Sanitize, validate and normalize lead payload\nconst item = $input.first().json;\nconst body = item.body || item;\n\nconst rawEmail = String(body.email || '').trim().toLowerCase();\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nif (!rawEmail || !emailRegex.test(rawEmail)) {\n  throw new Error('Validation Failed: Invalid corporate email address (' + rawEmail + ')');\n}\n\nconst rawName = String(body.name || 'Corporate Partner').trim();\nconst cleanName = rawName.replace(/[^a-zA-Z\\s\\.-]/g, '').slice(0, 80);\nconst company = String(body.company || 'Enterprise Partner').slice(0, 100).trim();\nconst role = String(body.role || 'Executive').slice(0, 60).trim();\n\nreturn [{\n  json: {\n    name: cleanName || 'Corporate Partner',\n    email: rawEmail,\n    company: company,\n    role: role,\n    ref: String(body.ref || 'li_mit').trim(),\n    received_at: new Date().toISOString(),\n    telegram_msg: '🎯 *New MIT Corporate Lead Captured!*\\n\\n' +\n      '👤 *Name:* ' + (cleanName || 'Corporate Partner') + '\\n' +\n      '📧 *Email:* `' + rawEmail + '`\\n' +\n      '🏢 *Company:* ' + company + '\\n' +\n      '💼 *Role:* ' + role + '\\n' +\n      '🕒 *Time:* ' + new Date().toISOString() + '\\n\\n' +\n      '⚡ *Fulfillment:* MkDocs Documentation link dispatched to user.\\n' +\n      '🔗 *Portal:* https://amz34.github.io/projects-market'\n  }\n}];"
      },
      "id": "code-validate-02",
      "name": "Validate & Sanitize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
